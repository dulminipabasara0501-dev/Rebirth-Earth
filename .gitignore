
# Unity .gitignore for Rebirth-Earth
# Works when a Unity project is in the repository root
# or inside a subfolder such as Rebirth_earth/

# Unity temporary and generated folders
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Unity log files
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Unity memory captures and recordings
[Mm]emoryCaptures/
[Rr]ecordings/

# Optional Asset Store Tools ignore
# [Aa]ssets/AssetStoreTools*

# JetBrains Rider generated files
[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Visual Studio cache
.vs/
.vscode/

# Gradle cache
.gradle/

# Generated IDE project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated Unity metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Generated application builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated files
crashlytics-build.properties

# TestRunner generated scenes
InitTestScene*.unity*

# Addressables generated content
ServerData/
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/Addressables_Temp*
[Aa]ssets/AddressableAssetsData/*/*.bin*

# Unity Visual Scripting generated files
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Generated play mode test scenes
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit generated schema
UIElementsSchema/

# Unity scene dependency cache
[Aa]ssets/[Ss]ceneDependencyCache*

# Operating system generated files
.DS_Store
Thumbs.db
Desktop.ini
